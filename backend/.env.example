# SQLite database file (relative to /backend)
DATABASE_URL=sqlite:///./coordinator.db

# --- Layer 1: primary cloud LLM (any OpenAI-compatible endpoint; the OPENCODE_* names are historical) ---
# Free: Groq  https://console.groq.com/keys
OPENCODE_BASE_URL=https://api.groq.com/openai/v1
OPENCODE_API_KEY=your-groq-api-key
OPENCODE_MODEL=openai/gpt-oss-120b
# Rotated to (in order) on rate limit / timeout / bad output
OPENCODE_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- Layer 2: Backup cloud LLM (any OpenAI-compatible endpoint) ---
# Free: Google Gemini  https://aistudio.google.com/apikey  (pick a fast "lite" model: the timeout is 6 s)
BACKUP_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
BACKUP_API_KEY=your-gemini-api-key
BACKUP_MODEL=gemini-3.1-flash-lite

# --- Layer 3: local LLM on this laptop (Ollama) - keeps the AI working with no internet ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# CPU-only laptops are slow: allow more time than the cloud layers, and keep answers short
OLLAMA_TIMEOUT_SECONDS=20
OLLAMA_MAX_TOKENS=400

# Per-request timeout before rotating to the next model (seconds)
LLM_TIMEOUT_SECONDS=6
# Set to 1 to force Layer 4 (Offline Smart Engine) - handy for demo rehearsals
LLM_FORCE_OFFLINE=0

# Telegram bot from @BotFather (Simulator Mode if unset/invalid).
# For group chats: /setprivacy -> Disable in @BotFather so the bot can read normal messages.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Set to 1 to never start polling (e.g. a second backend instance)
TELEGRAM_DISABLE_POLLING=0

# Optional Slack incoming webhook: mirrors every relay / escalation into a team channel
SLACK_WEBHOOK_URL=
# Optional: set to verify real GitHub webhook signatures (leave empty for simulated commits)
GITHUB_WEBHOOK_SECRET=

# Auto-Pilot (hands-free standups + blocker SLA). Demo-friendly defaults, in seconds.
AUTOPILOT_ON_START=0
AUTOPILOT_INTERVAL_SECONDS=45
BLOCKER_SLA_SECONDS=90
FOLLOWUP_COOLDOWN_SECONDS=90
STALE_IN_PROGRESS_SECONDS=120
